
lib/
 ├── core/                  # (الأساسيات المشتركة - لا تكثر فيها)
 │    ├── theme/            # (الألوان، الخطوط، أشكال الأزرار العامة)
 │    ├── router/           # (إعدادات GoRouter للتنقل)
 │    ├── constants/        # (النصوص الثابتة، الأرقام السحرية)
 │    └── utils/            # (دوال مساعدة عامة مثل تنسيق التواريخ)
 │
 ├── features/              # (المدينة الرئيسية - كل ميزة بمفردها)
 │    ├── auth/             # (ميزة التسجيل/الدخول)
 │    ├── home/             # (الصفحة الرئيسية)
 │    └── challenges/       # (ميزة التحديات)
 │
 ├── shared/                # (الأشياء المشتركة بين الميزات فقط)
 │    └── widgets/          # (مثلاً: زر مخصص تستخدمه في auth و home معاً)
 │
 └── main.dart              # (نقطة الدخول - تهيئة التطبيق والـ Theme والـ Router)

" مثال علي ميزه: "
lib/features/auth/
 ├── data/
 │   ├── datasources/      # مصادر البيانات الخارجية والمحلية
 │   ├── models/           # Models وتحويل JSON
 │   └── repositories/     # تنفيذ عقود Domain
 ├── domain/
 │   ├── entities/         # كيانات منطق التطبيق
 │   ├── repositories/     # عقود مجردة
 │   └── usecases/         # حالات الاستخدام عند الحاجة
 ├── presentation/               # (ما يراه المستخدم)
 │   ├── screens/                  # (الشاشات)
 |   ├── widgets/                     # (الويدجيتس المشتركة)                
 |   └── providers/                     # (موفر البيانات لي ال UI)
 └── onboarding.dart  (export)            # إستراد كل الملفات داخلة كي يتمكن الخارج من إسترادهم جميعا عبر ملف واحد

